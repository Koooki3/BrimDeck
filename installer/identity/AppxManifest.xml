<?xml version="1.0" encoding="utf-8"?>
<!-- An identity package for BrimDeck (a "sparse" package): it gives the installed BrimDeck.exe a package identity, without moving
     or repackaging anything, so that Windows raises its notification change events for dynamic notices instead of BrimDeck
     reading the list on a timer. The application files stay in the install folder (the external location); this package holds
     only this manifest and its logos. Register-NoticeIdentity.ps1 beside it registers and removes it. The names here must match
     the msix element in src/BrimDeck/app.manifest. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 uap10 rescap">
  <Identity Name="BrimDeck.Notices" Publisher="CN=BrimDeck" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>BrimDeck</DisplayName>
    <PublisherDisplayName>BrimDeck</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="zh-cn" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- BrimDeck keeps writing its settings and data where it always has, not to a package-private copy. -->
    <rescap:Capability Name="unvirtualizedResources" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
  <Applications>
    <!-- Not listed in Start: the existing shortcut keeps starting BrimDeck. -->
    <Application Id="BrimDeck" Executable="BrimDeck.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="BrimDeck" Description="BrimDeck" BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>
</Package>
