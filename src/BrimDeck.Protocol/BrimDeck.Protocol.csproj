<Project Sdk="Microsoft.NET.Sdk">

  <!-- The notice protocol shared by BrimDeck, its command-line sender (BrimDeck.Notify) and the WSL agent. It has no
       dependencies and is trimming-safe, since the WSL agent ships trimmed. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
