{
  // The custom-theme demo's sibling: an unofficial fan look inspired by the interface language of Arknights: Endfield
  // (Hypergryph). It is made of colors and shapes only, no artwork, logos, fonts or text from the game. The design notes are in
  // docs/zh-CN/themes.md.
  //   Paper and ink: the day look is the white studio of the game's menus (a near-white sheet, near-black ink, graphite lines), the
  //   night look its charcoal operation screen. Neutrals are over nine tenths of every look; the one signal, a hard yellow, points at
  //   what is current: the indicator, the selected segment, a chosen date, the bar at the open panel's lower left.
  //   Where yellow may be text (on charcoal) it is; on paper it is only ever a fill under ink, and the focus color is ink.
  //   Shapes: the island is a nameplate with 45-degree cut corners (the collapsed capsule stays a pill), its controls plates with barely
  //   softened corners. The only
  //   pictures are two marks on the open panel's bottom edge: the signal bar and a strip of hatching, as print on a panel.
  //   The look follows Windows (light or dark), not the clock: it is the display mode of a device, not a time of day.
  //   Two yellows share the work: the game's hazard yellow (#FFD400) for the large strips (the Indicator, the bar and the warning stripes at
  //   the panel's foot, the selected page on paper), the yellow-green of its HUD readouts (#C6CA4C, dark look) for the small ones; orange is
  //   a single diamond on the frame. Icons, bars and cards are drawn angular on this theme (IconStyle, UI.Bar, UI.Plate).
  "formatVersion": 1,
  "id": "endfield-industrial",
  "name": "明日方舟：终末地",
  "nameEn": "Arknights: Endfield",
  "stage": "alpha",
  "description": "非官方同人风格：纸与墨的工业面板，一处信号黄指向当前项，斜切 45° 的铭牌轮廓与斜纹，浅色与深色两套跟随 Windows。",
  "descriptionEn": "An unofficial fan look: an industrial panel of paper and ink, one signal yellow for what is current, a nameplate with 45-degree cut corners and hatching; a light and a dark look that follow Windows.",
  "author": "BrimDeck",
  "license": "Apache-2.0",
  "base": "dark",
  "colors": {
    "surface": "#FAFAFA",
    "textPrimary": "#141414",
    "textSecondary": "#333333",
    "textTertiary": "#4F4F4F",
    "accent": "#141414",
    "onAccent": "#FFD400",
    "danger": "#C61218",
    "liked": "#C61218",
    "clock": "#141414",
    "equalizer": "#141414",
    "hairline": "#D0D0D0",
    "track": "#D6D6D6",
    "ringTrack": "#D6D6D6",
    "fill": "#F0F0F0",
    "fillSelected": "#FFD400",
    "hover": "#E8E8E8",
    "pressed": "#DCDCDC",
    "outline": "#A8A8A8",
    "popup": "#FFFFFF",
    "popupBorder": "#707070",
    "input": "#F2F2F2",
    "rangeFill": "#80FFD400",
    "coverPlaceholder": "#E6E6E6",
    "coverOutline": "#B3B3B3",
    "scrollThumb": "#7A7A7A",
    "rim": "#A8A8A8",
    "shadow": "#000000",
    "indicator": "#FFD400",
    "indicatorProgress": "#141414",
    "switchFill": "#F0F0F0",
    "seekRail": "#D0D0D0",
    "rowDivider": "#DCDCDC",
    "rowHover": "#F0F0F0",
    "menuDetail": "#333333",
    "tooltip": "#FFFFFF",
    "tooltipBorder": "#141414",
    "bubble": "#FFFFFF",
    "bubbleBorder": "#141414"
  },
  // Identity by hue only where a column needs telling apart: the rarity ladder of blue, teal, green and violet, amber for the
  // brand that is orange; the rest are grays. Warning is the notice orange, critical the danger red.
  "apps": {
    "claude": "#A8620A", "codex": "#1F6FA3", "antigravity": "#047A7A", "cursor": "#3C3C3C", "zcode": "#6B35C9",
    "dsh": "#4D7A1C", "grokBot": "#5C5C5C", "kimi": "#A63FCB", "opencode": "#6B6B6B", "manual": "#3C3C3C", "other": "#5C5C5C", "warning": "#B84A00", "critical": "#C61218"
  },
  // The clock in the wide face, white-on-charcoal or ink-on-paper; the signal yellow is a preset, not the default.
  "clock": {
    "style": "wide", "color": "default",
    "palette": { "amber": "#6B5D00", "cyan": "#1F6FA3", "pink": "#6B6B6B", "lime": "#4D7A1C" },
    "gradients": [
      { "name": "信号", "nameEn": "Signal", "stops": ["#6B5D00", "#B84A00", "#C61218"] },
      { "name": "量测", "nameEn": "Gauge", "stops": ["#1F6FA3", "#047A7A", "#4D7A1C"] },
      { "name": "石墨", "nameEn": "Graphite", "stops": ["#191919", "#3C3C3C", "#5C5C5C"] },
      { "name": "地区", "nameEn": "Region", "stops": ["#047A7A", "#1F6FA3", "#6B35C9"] },
      { "name": "稀有", "nameEn": "Rarity", "stops": ["#5C5C5C", "#4D7A1C", "#A8620A"] }
    ]
  },
  "effects": {
    "surfaceGradient": [], "rimGradient": [], "rimWidth": 1,
    // An ambient shadow with no offset to speak of and no color.
    "shadowBlur": 16, "shadowDepth": 1, "shadowOpacity": 0.22,
    "scanlines": 0,
    // Cut corners (each at most its corner's radius; a collapsed capsule stays a pill, as a readout is a pill in the game) and, along
    // the open panel's bottom edge, the signal bar at the left and a strip of hatching at the right, in ink at a fifth of its strength.
    "cut": 10,
    "decor": { "tab": { "color": "#FFD400" }, "hatch": { "color": "#38141414" }, "frame": { "color": "#26141414" }, "diamond": { "color": "#FC6C00" }, "cross": { "color": "#80141414" } }
  },
  // Mechanical, never springy: a hovered control gets the line highlight and a bar at its left (a record shifting into focus), a
  // press shades the plate as a graphite button does, keyboard focus is the four corner brackets of a selected item. The springs are
  // firm, nothing breathes, flashes or leaves particles, and nothing runs while the island is idle.
  "motion": {
    "ambient": { "breathe": 0, "breatheDepth": 0, "drift": 0, "sweep": 0, "sweepOpacity": 0, "flicker": 0, "flickerDepth": 0 },
    "hover": "caret", "hoverStrength": 0.2, "press": "shade", "pressStrength": 0.3, "trail": 0, "particles": "none", "spring": "firm",
    "focus": "brackets", "pace": 1, "steps": 0, "color": "accent", "secondary": "textSecondary", "highlight": "indicator"
  },
  "daylight": { "mode": "system" },
  // The night look: a deep charcoal (#121212), the game's HUD dark, in which the layers come from hairlines (the rim, the frame, the
  // dividers) and faint steps of brightness, never from lightening the base. All three text levels read at 7:1 or more. Its signal is the
  // yellow-green of that HUD (#C6CA4C, as the Endfield Charge Plus project measured and a screenshot confirms), not the site's pure
  // #FFFA00, and it is spent sparingly: progress, the indicator, the current page, focus, the bar at the panel's foot.
  "night": {
    "colors": {
      "surface": "#121212",
      "textPrimary": "#F5F5F5",
      "textSecondary": "#D4D4D4",
      "textTertiary": "#A9A9A9",
      "accent": "#C6CA4C",
      "onAccent": "#121212",
      "danger": "#FF6F67",
      "liked": "#FF6F67",
      "clock": "#F5F5F5",
      "equalizer": "#C6CA4C",
      "hairline": "#2A2A2A",
      "track": "#2E2E2E",
      "ringTrack": "#2E2E2E",
      "fill": "#191919",
      "fillSelected": "#2C2C2C",
      "hover": "#222222",
      "pressed": "#2A2A2A",
      "outline": "#3D3D3D",
      "popup": "#1A1A1A",
      "popupBorder": "#4D4D4D",
      "input": "#0B0B0B",
      "rangeFill": "#33C6CA4C",
      "coverPlaceholder": "#1C1C1C",
      "coverOutline": "#4A4A4A",
      "scrollThumb": "#6B6B6B",
      "rim": "#4D4D4D",
      "shadow": "#000000",
      "indicator": "#FFD400",
      "indicatorProgress": "#121212",
      "switchFill": "#181818",
      "seekRail": "#303030",
      "rowDivider": "#242424",
      "rowHover": "#191919",
      "menuDetail": "#D4D4D4",
      "tooltip": "#1E1E1E",
      "tooltipBorder": "#5A5A5A",
      "bubble": "#1E1E1E",
      "bubbleBorder": "#5A5A5A"
    },
    "apps": {
      "claude": "#FC9C1E", "codex": "#4BB4E6", "antigravity": "#06C2C2", "cursor": "#CCCCCC", "zcode": "#9B6BF7",
      "dsh": "#8BC34A", "grokBot": "#9A9A9A", "kimi": "#D272FC", "opencode": "#8A8A8A", "manual": "#CCCCCC", "other": "#CCCCCC", "warning": "#FC6C00", "critical": "#FF6F67"
    },
    "clock": {
      "palette": { "amber": "#C6CA4C", "cyan": "#4BB4E6", "pink": "#9C9C9C", "lime": "#B4D44A" },
      "gradients": [
        { "name": "信号", "nameEn": "Signal", "stops": ["#C6CA4C", "#FC9C1E", "#FF6F67"] },
        { "name": "量测", "nameEn": "Gauge", "stops": ["#4BB4E6", "#06C2C2", "#8BC34A"] },
        { "name": "石墨", "nameEn": "Graphite", "stops": ["#F5F5F5", "#D4D4D4", "#A9A9A9"] },
        { "name": "地区", "nameEn": "Region", "stops": ["#06C2C2", "#4BB4E6", "#B79BFF"] },
        { "name": "稀有", "nameEn": "Rarity", "stops": ["#A9A9A9", "#8BC34A", "#FC9C1E"] }
      ]
    },
    "effects": {
      "shadowOpacity": 0.6,
      "decor": { "tab": { "color": "#FFD400" }, "hatch": { "color": "#D9FFD400" }, "frame": { "color": "#30FFFFFF" }, "diamond": { "color": "#FC6C00" }, "cross": { "color": "#80F5F5F5" } }
    }
  }
}
