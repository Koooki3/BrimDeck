{
  // Island holiday 2: a seaside postcard that is light by day, warm at dusk and dark by night, changing by the local clock
  // (06:30 and 18:30, dusk the hour before, unless the settings move them or follow Windows' light and dark).
  //   Day: a clear sky fading into the warm haze of the horizon, and below it the lagoon: a turquoise sea with the soft net of
  //   light a sunlit sea throws, and the shade of a palm frond falling into the open panel's corner. Deep-sea text, a lagoon
  //   accent, a sunburnt coral clock, a mango indicator and hibiscus for liked songs. The rim is the shore: lagoon, sky, sand,
  //   coral. The light breathes like a swell, the rim's colors flow like water and a glint of sun crosses the surface now and
  //   then; a completed press leaves glints on the corners.
  //   Night: a moonlit sea, deep navy into a dark teal sea under a horizon lit in moon gold, moonlight playing faintly on the
  //   water, lantern-gold clock, a soft bioluminescent glow under the island, and a press lets glowing plankton rise.
  // The motifs are drawn, not pictures: no image ships with the theme.
  "formatVersion": 1,
  "id": "island-holiday-2",
  "name": "海岛假日 2",
  "nameEn": "Island Holiday 2",
  "description": "海岛明信片：白天是晴空、泻湖海面上的粼粼水光与棕榈叶影，椰林描边、珊瑚色时钟、芒果色指示条；夜晚是月光海面与夜光浮游，按本地时间自动切换。",
  "descriptionEn": "An island postcard: a clear sky over a lagoon with sunlit ripples and a palm's shade by day, a moonlit sea with glowing plankton by night, switching by the local clock.",
  "author": "BrimDeck",
  "license": "Apache-2.0",
  "base": "light",
  // The hour before night is dusk; "跟随系统深浅" in settings (or "mode": "system") follows Windows' light and dark instead.
  "daylight": { "mode": "clock", "day": "06:30", "night": "18:30", "duskMinutes": 60 },
  "colors": {
    "surface": "#FFF7EA",
    "textPrimary": "#0B2E3A",
    "textSecondary": "#1D3B47",
    "textTertiary": "#395661",
    "accent": "#00676E",
    "onAccent": "#FFFFFF",
    "danger": "#922A1F",
    "liked": "#C2185B",
    "clock": "#902E14",
    "equalizer": "#00747F",
    "hairline": "#1A0B2E3A",
    "track": "#230B2E3A",
    "ringTrack": "#400B2E3A",
    "fill": "#120B2E3A",
    "fillSelected": "#240B2E3A",
    "hover": "#170B2E3A",
    "pressed": "#2B0B2E3A",
    "outline": "#330B2E3A",
    "popup": "#FFFBF4",
    "popupBorder": "#2E0B2E3A",
    "input": "#F7EFE2",
    "rangeFill": "#3300676E",
    "coverPlaceholder": "#140B2E3A",
    "coverOutline": "#1F0B2E3A",
    "scrollThumb": "#728F88",
    "rim": "#1FC8C3",
    "shadow": "#0B5560",
    "indicator": "#FFA41B",
    "indicatorProgress": "#0B2E3A",
    "switchFill": "#0F0B2E3A",
    "seekRail": "#290B2E3A",
    "rowDivider": "#120B2E3A",
    "rowHover": "#0D0B2E3A",
    "menuDetail": "#3F5F6A",
    "tooltip": "#FFFBF4",
    "tooltipBorder": "#330B2E3A",
    "bubble": "#FFFBF4",
    "bubbleBorder": "#290B2E3A"
  },
  "apps": {
    "claude": "#AB4E2B", "codex": "#1A7A4B", "antigravity": "#2D60C2", "cursor": "#5A646C", "zcode": "#334E88",
    "dsh": "#385BB9", "grokBot": "#5A646C", "kimi": "#07728D", "manual": "#8744B2", "other": "#5A646C", "warning": "#6F4B00", "critical": "#922A1F"
  },
  "clock": {
    "style": "rounded", "color": "default",
    "palette": { "amber": "#744500", "cyan": "#075960", "pink": "#8C2C54", "lime": "#3A5800" },
    "gradients": [
      { "name": "日落", "nameEn": "Sunset", "stops": ["#86390C", "#8C2C54", "#5838AD"] },
      { "name": "海洋", "nameEn": "Ocean", "stops": ["#075960", "#184E9C", "#4A3BB5"] },
      { "name": "极光", "nameEn": "Aurora", "stops": ["#225B25", "#075960", "#184E9C"] },
      { "name": "火焰", "nameEn": "Ember", "stops": ["#744500", "#86390C", "#922A1F"] },
      { "name": "霓虹", "nameEn": "Neon", "stops": ["#8A237C", "#5838AD", "#075960"] }
    ]
  },
  "effects": {
    // A clear sky at the top, the warm haze of the horizon, the sand's warmth at the bottom (under the sea).
    "surfaceGradient": ["#A8E1F8", "#D6F2F8", "#FFF2DA"],
    // The shore along the rim: lagoon, sky, sand, coral.
    "rimGradient": ["#1FC8C3", "#7ED6F5", "#FFE3A3", "#FF8A65", "#1FC8C3"],
    "rimWidth": 1.25,
    "shadowBlur": 16,
    "shadowDepth": 3,
    "shadowOpacity": 0.22,
    // The lagoon below a horizon about two thirds down (in the gap under the usage page's third row), a line of sunlight along it, the light the sea throws, and
    // a palm frond's shade in the open panel's corner.
    "decor": {
      "horizon": { "at": 0.655, "sea": "#4038CFE0", "line": "#E6FFFFFF" },
      "caustics": { "color": "#33FFFFFF" },
      "palm": { "color": "#1F08402A" }
    }
  },
  // A slow swell (the rim dims a little every 9 s), the shoreline's colors flowing along the rim and a glint of sun crossing
  // the surface every 26 s. A wave rolls in along a hovered control; a press spreads a ring of water from the control and a
  // completed one lets a few bubbles rise. The panel goes back into the island as foam, dissolving.
  "motion": {
    "ambient": { "breathe": 9, "breatheDepth": 0.12, "drift": 20, "sweep": 26, "sweepOpacity": 0.05, "flicker": 0, "flickerDepth": 0 },
    "hover": "wave", "hoverStrength": 0.12, "press": "splash", "pressStrength": 0.18, "trail": 0.35, "particles": "bubble", "spring": "default", "splashMs": 500, "particleMs": 1450, "focus": "glow", "pace": 1.15, "steps": 0,
    "color": "accent", "secondary": "clock", "highlight": "clock"
  },
  // Dusk, the hour before night: a peach sunset sky over a sea warmed by the low sun, a gold line along the horizon and
  // gold light on the water; the rim turns to sunset colors. Laid over the day look.
  "dusk": {
    "colors": { "rim": "#FF8A65", "indicator": "#FF8A65" },
    "effects": {
      "surfaceGradient": ["#FFD6B4", "#FFE5CB", "#FFF1DE"],
      "rimGradient": ["#FF8A65", "#FFB627", "#FFE3A3", "#C2185B", "#FF8A65"],
      "decor": {
        "horizon": { "at": 0.655, "sea": "#29F07A4A", "line": "#99FFC24B" },
        "caustics": { "color": "#33FFD27A" },
        "palm": { "color": "#1F2A1A10" }
      }
    }
  },
  "night": {
    "colors": {
      "surface": "#001E3C",
      "textPrimary": "#EEF7F8",
      "textSecondary": "#DCE8EA",
      "textTertiary": "#ADC0C7",
      "accent": "#45D5C8",
      "onAccent": "#05222A",
      "danger": "#FFA095",
      "liked": "#FF7397",
      "clock": "#FFD27A",
      "equalizer": "#45D5C8",
      "hairline": "#1FB1E0E6",
