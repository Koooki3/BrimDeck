      "ringTrack": "#33B1E0E6",
      "fill": "#14B1E0E6",
      "fillSelected": "#26B1E0E6",
      "hover": "#1FB1E0E6",
      "pressed": "#33B1E0E6",
      "outline": "#3DB1E0E6",
      "popup": "#0A2742",
      "popupBorder": "#4045D5C8",
      "input": "#001830",
      "rangeFill": "#4045D5C8",
      "coverPlaceholder": "#14B1E0E6",
      "coverOutline": "#26B1E0E6",
      "scrollThumb": "#57809E",
      "rim": "#45D5C8",
      "shadow": "#2FC9BE",
      "indicator": "#5C7590",
      "indicatorProgress": "#071320",
      "switchFill": "#12B1E0E6",
      "seekRail": "#38B1E0E6",
      "rowDivider": "#14B1E0E6",
      "rowHover": "#0FB1E0E6",
      "menuDetail": "#DCE8EA",
      "tooltip": "#0A2742",
      "tooltipBorder": "#4D45D5C8",
      "bubble": "#0E3050",
      "bubbleBorder": "#2E45D5C8"
    },
    "apps": {
      "claude": "#F0AC8C", "codex": "#8EE3B1", "antigravity": "#9EBBFF", "cursor": "#D3DCE2", "zcode": "#9AACEB",
      "dsh": "#8FAEF2", "grokBot": "#D3DCE2", "kimi": "#6FD8F2", "manual": "#D2A6F2", "other": "#D3DCE2", "warning": "#FFD27A", "critical": "#FFA5A5"
    },
    "clock": {
      "palette": { "amber": "#FFC06B", "cyan": "#6FE8E0", "pink": "#FF9EC4", "lime": "#D9FF86" },
      "gradients": [
        { "name": "日落", "nameEn": "Sunset", "stops": ["#FFD27A", "#FFA08F", "#FF99C6"] },
        { "name": "海洋", "nameEn": "Ocean", "stops": ["#7CF2E8", "#6FC6FF", "#B3B2FF"] },
        { "name": "极光", "nameEn": "Aurora", "stops": ["#93FFB8", "#6FE8E0", "#B3B2FF"] },
        { "name": "火焰", "nameEn": "Ember", "stops": ["#FFE18A", "#FFC06B", "#FFA095"] },
        { "name": "霓虹", "nameEn": "Neon", "stops": ["#FF93EE", "#C2ADFF", "#6FE8E0"] }
      ]
    },
    "effects": {
      // Deep ocean navy at the top, the sea deepening into teal below; a moonlit shoreline along the rim; a soft glow, no shadow.
      "surfaceGradient": ["#001E3C", "#03294A", "#06344A"],
      "rimGradient": ["#45D5C8", "#5D7FD8", "#FFD27A", "#FF8F70", "#45D5C8"],
      "rimWidth": 1.25,
      "shadowBlur": 16,
      "shadowDepth": 0,
      "shadowOpacity": 0.34,
      // A dark teal sea under a horizon lit in moon gold, moonlight playing faintly on it.
      "decor": {
        "horizon": { "at": 0.655, "sea": "#990A4A5E", "line": "#14FFD27A" },
        "caustics": { "color": "#0C9FE8FF" },
        // No palm at night: its shade would only smudge the dark water.
        "palm": { "color": "#00000000" }
      }
    },
    // The swell is slower at night and the moon's glint rarer; a completed press lets glowing plankton rise from the ring of water.
    "motion": {
      "ambient": { "breathe": 11, "breatheDepth": 0.14, "drift": 24, "sweep": 40, "sweepOpacity": 0.04, "flicker": 0, "flickerDepth": 0 },
      "hover": "wave", "hoverStrength": 0.14, "press": "splash", "pressStrength": 0.2, "trail": 0.4, "particles": "firefly", "focus": "glow",
      "color": "accent", "secondary": "clock", "highlight": "accent"
    }
  }
