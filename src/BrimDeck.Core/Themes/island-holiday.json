{
  // Island holiday: a seaside theme that is light by day and dark by night, changing by the local clock (06:30 and 18:30
  // unless the settings move them).
  //   Day: warm sand at the top fading into sea foam, deep-sea text, a lagoon turquoise for focus and tracks and a coral clock.
  //   The rim is the shoreline: turquoise, sky and sand, and the shadow is a soft sea-green.
  //   Night: a moonlit sea, deep navy into teal, a lantern-gold clock and a soft bioluminescent glow under the island instead
  //   of a shadow.
  "formatVersion": 1,
  "id": "island-holiday",
  "name": "海岛假日",
  "nameEn": "Island Holiday",
  "description": "白天是暖沙与泻湖的浅色，夜晚是月光海面的深色，按本地时间自动渐变切换；夜里岛下泛起柔和的海光。",
  "descriptionEn": "Warm sand and lagoon by day, a moonlit sea by night, fading over by the local clock; at night a soft sea glow lies under the island.",
  "author": "BrimDeck",
  "license": "Apache-2.0",
  "base": "light",
  "daylight": { "day": "06:30", "night": "18:30" },
