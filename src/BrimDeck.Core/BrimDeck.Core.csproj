<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Every package, transitive ones too, restored at the version recorded in packages.lock.json. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The release is published for win-x64 (scripts/Publish-Release.ps1): restored for it always, so the lock file is the same
         with or without a runtime. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built-in panel themes and the custom-theme template; see PanelThemes. -->
    <!-- Fixed resource names: a built-in theme's id is its file name (PanelThemes.BuiltInIndex). -->
    <EmbeddedResource Include="Themes\*.json" LogicalName="BrimDeck.Core.Themes.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Templates\theme-template.json" LogicalName="BrimDeck.Core.Templates.theme-template.json" />
    <ProjectReference Include="..\BrimDeck.Protocol\BrimDeck.Protocol.csproj" />
    <!-- NoticeHistory.PlainProtector is for the tests only. -->
    <InternalsVisibleTo Include="BrimDeck.Tests" />
    <!-- Release notes for the What's new window; see ReleaseHistory. The file name is the version. -->
    <EmbeddedResource Include="..\..\releases\*.md" LogicalName="BrimDeck.Core.Releases.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.16.3" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

</Project>
