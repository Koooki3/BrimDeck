<Project Sdk="Microsoft.NET.Sdk">

  <!-- The agent BrimDeck copies into a WSL distribution the user chose. BrimDeck starts it through wsl.exe and reads its
       standard output; it receives the distribution's desktop notifications over the session bus and serves brim-notify.
       Published for linux-x64 as one trimmed, self-contained file (see scripts/Publish-Release.ps1):
       dotnet publish src/BrimDeck.WslAgent -c Release -r linux-x64 -->
  <ItemGroup>
    <ProjectReference Include="..\BrimDeck.Protocol\BrimDeck.Protocol.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>brimdeck-agent</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <EventSourceSupport>false</EventSourceSupport>
  </PropertyGroup>

  <Import Project="..\BrimDeck\ReleaseVersion.targets" />

</Project>
