<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck">
  <Style x:Key="PanelIconButton" TargetType="Button">
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="28"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource PanelKeyboardFocus}"/>
    <!-- Hover and press fade (Feedback): the layers lie under the chrome, whose own background is the selected fill. -->
    <Setter Property="local:Feedback.Fade" Value="True"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{Binding CornerRadius, ElementName=Chrome}" Opacity="0"/>
          <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="{Binding CornerRadius, ElementName=Chrome}" Opacity="0"/>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelR5}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="PanelSourceButton" TargetType="Button" BasedOn="{StaticResource PanelIconButton}">
    <Setter Property="Height" Value="24"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
          <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PanelR6}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/></Trigger>
          <DataTrigger Binding="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}}" Value="True">
            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelPressed}"/><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/>
          </DataTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <!-- An icon button without a hover background: the icon fills most of its box, so hover only brightens the icon.
       The foreground is set from code (the paused sync turns red), so the icon's opacity carries the feedback. -->
  <Style x:Key="PanelGlyphButton" TargetType="Button" BasedOn="{StaticResource PanelIconButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity=".78"/>
      </Border>
      <!-- The glyph's opacity follows hover and press through Feedback (.78 at rest, 1 hovered, .6 pressed). -->
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PanelSettingsButton" TargetType="Button" BasedOn="{StaticResource PanelIconButton}">
    <Setter Property="Width" Value="28"/><Setter Property="Height" Value="24"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
        <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="{DynamicResource PanelR6}" Opacity="0"/>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PanelR6}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MediaSourceMenu" TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="Width" Value="280"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="Background" Value="{DynamicResource PanelPopup}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource PanelPopupBorder}" BorderThickness="1" CornerRadius="{DynamicResource PanelR8}" Padding="{TemplateBinding Padding}">
        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/>
        </ScrollViewer>
      </Border>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MediaSourceMenuItem" TargetType="MenuItem">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="8,0,10,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
      <Border x:Name="Chrome" Background="Transparent" CornerRadius="{DynamicResource PanelR5}" Height="{TemplateBinding Height}" Padding="{TemplateBinding Padding}">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="10"/><ColumnDefinition Width="4"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <!-- The check column doubles as the pin control. Its 16 DIP hit area reaches into the
               padding and gap around the 10 DIP column, so the text does not move. -->
          <Button x:Name="PinButton" Width="16" Height="16" Margin="-3,0" Focusable="False" Cursor="Hand" VerticalAlignment="Center"
                  AutomationProperties.Name="{DynamicResource PinSourceName}">
            <Button.Template><ControlTemplate TargetType="Button"><Border Background="Transparent"><ContentPresenter/></Border></ControlTemplate></Button.Template>
            <Grid Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas x:Name="Checkmark" Width="10" Height="10" Visibility="Hidden">
                <Path Data="M1.5,5.2 L4,7.7 L8.5,2.5" Stroke="{DynamicResource PanelPrimary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Canvas>
              <Viewbox x:Name="PinOutline" Width="10" Height="10" Visibility="Hidden">
                <Canvas Width="16" Height="16">
                  <Path Data="M9.6,1.6 L14.4,6.4 L12.2,7.3 L9.3,10.2 L9.7,12.8 L8.4,14.1 L1.9,7.6 L3.2,6.3 L5.8,6.7 L8.7,3.8 Z" Stroke="{DynamicResource PanelSecondary}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                  <Path Data="M5.1,10.9 L1.6,14.4" Stroke="{DynamicResource PanelSecondary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
              <Viewbox x:Name="PinFilled" Width="10" Height="10" Visibility="Hidden">
                <Canvas Width="16" Height="16">
                  <Path Data="M9.6,1.6 L14.4,6.4 L12.2,7.3 L9.3,10.2 L9.7,12.8 L8.4,14.1 L1.9,7.6 L3.2,6.3 L5.8,6.7 L8.7,3.8 Z" Fill="{DynamicResource PanelPrimary}" Stroke="{DynamicResource PanelPrimary}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                  <Path Data="M5.1,10.9 L1.6,14.4" Stroke="{DynamicResource PanelPrimary}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Grid>
          </Button>
          <ContentPresenter Grid.Column="2" ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
        </Grid>
      </Border>
      <!-- Later triggers win. At rest every row shows only its check. On hover the check column becomes the pin:
           outline for an unpinned row, filled for the pinned one. Tag is "pinned" for the pinned row and "single"
           when there is nothing to choose between; a single row keeps its check on hover. -->
      <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHover}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter TargetName="Checkmark" Property="Visibility" Value="Hidden"/><Setter TargetName="PinOutline" Property="Visibility" Value="Visible"/>
        </Trigger>
        <Trigger Property="Tag" Value="single">
          <Setter TargetName="PinButton" Property="IsHitTestVisible" Value="False"/><Setter TargetName="PinOutline" Property="Visibility" Value="Hidden"/>
        </Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions><Condition Property="Tag" Value="single"/><Condition Property="IsChecked" Value="True"/></MultiTrigger.Conditions>
          <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <Trigger Property="Tag" Value="pinned"><Setter TargetName="PinButton" Property="AutomationProperties.Name" Value="{DynamicResource UnpinSourceName}"/></Trigger>
        <MultiTrigger>
          <MultiTrigger.Conditions><Condition Property="Tag" Value="pinned"/><Condition Property="IsHighlighted" Value="True"/></MultiTrigger.Conditions>
          <Setter TargetName="PinOutline" Property="Visibility" Value="Hidden"/><Setter TargetName="PinFilled" Property="Visibility" Value="Visible"/>
        </MultiTrigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger>
        <!-- An action row below the sources keeps the check column empty so its text lines up with theirs. -->
        <Trigger Property="Tag" Value="action"><Setter TargetName="PinButton" Property="Visibility" Value="Hidden"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MediaSourceMenuSeparator" TargetType="Separator">
    <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator">
      <Border Height="1" Background="{DynamicResource PanelPopupBorder}"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PanelTextButton" TargetType="Button" BasedOn="{StaticResource PanelIconButton}">
    <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="8,2"/>
    <Setter Property="FontSize" Value="11"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".28"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- A text action with an outline, for a pop-up whose other content does not read as clickable (the process card). -->
  <Style x:Key="PanelOutlineButton" TargetType="Button" BasedOn="{StaticResource PanelTextButton}">
    <Setter Property="BorderBrush" Value="{DynamicResource PanelPopupBorder}"/>
  </Style>
</ResourceDictionary>
