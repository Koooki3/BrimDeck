<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck">
  <Style x:Key="MusicKeyboardFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Ellipse Stroke="{DynamicResource PanelAccent}" StrokeThickness="1"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MusicControl" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ToolTipService.IsEnabled" Value="False"/><Setter Property="FocusVisualStyle" Value="{StaticResource MusicKeyboardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid Background="Transparent" RenderTransformOrigin=".5,.5">
        <Grid.RenderTransform><ScaleTransform x:Name="ControlScale"/></Grid.RenderTransform>
        <Ellipse x:Name="Hover" Fill="{DynamicResource PanelPrimary}" Opacity="0" Stretch="Uniform"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".28"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MusicTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border Background="{TemplateBinding Background}" Height="{Binding BarHeight, RelativeSource={RelativeSource AncestorType={x:Type local:MusicSeekSlider}}}" CornerRadius="{DynamicResource PanelR4}"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A pill around the whole 18 DIP seek target, whose bar runs edge to edge. -->
  <Style x:Key="MusicSeekKeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource PanelAccent}" BorderThickness="1" CornerRadius="{DynamicResource PanelR9}" Margin="-6,0"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="MusicSeek" TargetType="{x:Type local:MusicSeekSlider}">
    <Setter Property="ToolTipService.IsEnabled" Value="False"/><Setter Property="FocusVisualStyle" Value="{StaticResource MusicSeekKeyboardFocus}"/>
    <Setter Property="Height" Value="18"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="1"/>
    <Setter Property="SmallChange" Value=".02"/><Setter Property="LargeChange" Value=".1"/><Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type local:MusicSeekSlider}">
      <!-- The bar is drawn inside the hit area's inset (HitArea); the whole box takes the pointer. -->
      <Grid Background="Transparent"><Grid x:Name="Face" Margin="{TemplateBinding local:HitArea.Inset}">
        <Border x:Name="Rail" Background="{DynamicResource PanelSeekRail}" Height="{TemplateBinding BarHeight}" CornerRadius="{DynamicResource PanelR4}"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource MusicTrackButton}" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="SeekThumb" Width="0" Height="0"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource MusicTrackButton}" Command="Slider.IncreaseLarge" Background="Transparent"/></Track.IncreaseRepeatButton>
        </Track>
        <Canvas IsHitTestVisible="False">
          <Border x:Name="TimeBubble" Canvas.Left="{TemplateBinding BubbleX}" Canvas.Top="-27" Width="52" Height="24" Background="{DynamicResource PanelBubble}" BorderBrush="{DynamicResource PanelBubbleBorder}" BorderThickness="1" CornerRadius="{DynamicResource PanelR5}" Visibility="{TemplateBinding BubbleVisible}">
            <TextBlock Text="{TemplateBinding BubbleText}" Foreground="{DynamicResource PanelPrimary}" FontFamily="Segoe UI" FontSize="11.5" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Canvas>
      </Grid></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
