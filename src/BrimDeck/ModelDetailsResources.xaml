<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck">
  <Style x:Key="DetailLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource PanelKeyboardFocus}"/>
    <Setter Property="local:Feedback.Fade" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <!-- The face is drawn inside the hit area's inset (HitArea); the edge around it only takes the pointer. -->
      <Grid Background="Transparent"><Grid x:Name="Face" Margin="{TemplateBinding local:HitArea.Inset}">
        <Border x:Name="HoverLayer" Background="{DynamicResource PanelFill}" CornerRadius="{DynamicResource PanelR5}" Opacity="0"/>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource PanelR5}" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
        </Border>
      </Grid></Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The date range picker's buttons (ModelDatePicker): hover and press fade as the monitor's do (Feedback) over the face, and
       nothing switches in one frame; the picker eases a disabled button's opacity itself. -->
  <Style x:Key="DatePickerButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource PanelKeyboardFocus}"/>
    <Setter Property="local:Feedback.Fade" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid>
        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"/>
        <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="8" Opacity="0"/>
        <Border x:Name="PressLayer" Background="{DynamicResource PanelPressed}" CornerRadius="8" Opacity="0"/>
        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The scrollbar lies in the right inset, outside the shared table width. -->
  <Style x:Key="ModelScrollViewer" TargetType="ScrollViewer">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="PanningMode" Value="VerticalOnly"/><Setter Property="CanContentScroll" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
      <Grid>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" CanContentScroll="{TemplateBinding CanContentScroll}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Width="6" Margin="0,0,-11,0" Orientation="Vertical"
          Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}"
          ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
</ResourceDictionary>
