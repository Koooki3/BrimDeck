<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <PopupAnimation x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}">None</PopupAnimation>
  <Style TargetType="ToolTip" BasedOn="{StaticResource BrimDeckToolTip}">
    <!-- The settings follow Windows, not the panel theme: their tooltips keep the rounded corner a pixel theme squares. -->
    <Style.Resources><CornerRadius x:Key="PanelR6">6</CornerRadius></Style.Resources>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsPopup}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/>
  </Style>
  <SolidColorBrush x:Key="SettingsAccent" Color="#0A84FF"/>
  <SolidColorBrush x:Key="SettingsAccentHover" Color="#3395FF"/>
  <SolidColorBrush x:Key="SettingsTextPrimary" Color="#F2F2F4"/>
  <SolidColorBrush x:Key="SettingsTextSecondary" Color="#9B9BA3"/>
  <SolidColorBrush x:Key="SettingsFillHover" Color="#14FFFFFF"/>
  <SolidColorBrush x:Key="SettingsFillPressed" Color="#24FFFFFF"/>
  <SolidColorBrush x:Key="SettingsFillSelected" Color="#2EFFFFFF"/>
  <!-- Focus outlines are drawn only while moving focus with the keyboard, never after a mouse click. -->
  <Style x:Key="SettingsFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1" CornerRadius="6" Margin="-2"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- Rings the preview card only; the caption row below it (30 + 4 DIP) stays outside. -->
  <Style x:Key="SettingsCardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1.5" CornerRadius="15" Margin="-3,-3,-3,31"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsRoundFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Ellipse Stroke="{DynamicResource SettingsAccent}" StrokeThickness="2"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- The switch is docked right in its control, so the outline hugs only the switch.
       No fixed height: an outline taller than its slot is cut off at the top and bottom. -->
  <Style x:Key="SettingsSwitchFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1" CornerRadius="13" Width="42" HorizontalAlignment="Right" Margin="-2"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- The steppers sit inside the number box, so their outline stays within the button. -->
  <Style x:Key="SettingsStepperFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1" CornerRadius="4" Margin="0,2"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- Help marks: a circle around the 14 DIP mark in its 22 × 24 target, and around the 12 DIP column mark. -->
  <Style x:Key="SettingsHelpFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Ellipse Stroke="{DynamicResource SettingsAccent}" StrokeThickness="1" Margin="2,3"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsSmallHelpFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Ellipse Stroke="{DynamicResource SettingsAccent}" StrokeThickness="1" Margin="-2"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="SettingsButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,5"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsFillHover}"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsFillPressed}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsColorButton" TargetType="Button">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsRoundFocus}"/>
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <!-- Keep both circles in one unrounded coordinate space: a Border's rounded
           padding can move its child by half a physical pixel at fractional DPI. -->
      <Grid Width="32" Height="32" Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Ellipse x:Name="Ring" Width="32" Height="32" Stroke="{DynamicResource SettingsSwatchBorder}" StrokeThickness="1" Fill="{DynamicResource SettingsInput}"/>
        <Ellipse x:Name="ColorDisc" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Fill" Value="{DynamicResource SettingsFillHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource SettingsAccent}"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <!-- Measured on the rendered button, the semibold Chinese label sits 1 unit below centre; this lifts it back. -->
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.RenderTransform><TranslateTransform Y="-1"/></ContentPresenter.RenderTransform></ContentPresenter>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsAccentHover}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- An action that cannot be undone, in a confirmation: red instead of the accent. -->
  <Style x:Key="SettingsDangerButton" TargetType="Button" BasedOn="{StaticResource SettingsPrimaryButton}">
    <Setter Property="Background" Value="#C42B1C"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.RenderTransform><TranslateTransform Y="-1"/></ContentPresenter.RenderTransform></ContentPresenter>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#D83B2C"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The delete button on a custom theme's card: a round chip at the preview's top right corner, red under the pointer. -->
  <Style x:Key="SettingsCardDelete" TargetType="Button">
    <Setter Property="Width" Value="22"/><Setter Property="Height" Value="22"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#A6202024"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsRoundFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Grid UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Ellipse x:Name="Disc" Fill="{TemplateBinding Background}" Stroke="#40FFFFFF" StrokeThickness="1"/>
        <Path Data="M 0,0 L 7,7 M 7,0 L 0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="Fill" Value="#C42B1C"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.8"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A custom theme's name under its card: plain text that renames the theme when clicked. -->
  <Style x:Key="SettingsCardName" TargetType="Button">
    <Setter Property="Cursor" Value="IBeam"/><Setter Property="FocusVisualStyle" Value="{DynamicResource SettingsGlyphFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Background="Transparent" Padding="4,0">
        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}"
          FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A secondary action that still reads as a button: input fill with the standard border. -->
  <Style x:Key="SettingsOutlineButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="Background" Value="{DynamicResource SettingsInput}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/><Setter Property="Padding" Value="14,6"/>
  </Style>
  <!-- Drawn only while moving focus with the keyboard, never after a mouse click. -->
  <Style x:Key="SettingsGlyphFocus">
    <Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1" CornerRadius="4"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A bare icon button: hover brightens the icon instead of filling a box behind it. -->
  <Style x:Key="SettingsGlyphButton" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsGlyphFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- An external link shown as plain text, so it lines up with neighbouring values. -->
  <Style x:Key="SettingsLink" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border Background="Transparent" Padding="{TemplateBinding Padding}">
        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Text" Property="TextDecorations" Value="Underline"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsCloseButton" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
    <Setter Property="Height" Value="38"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <Border x:Name="Chrome" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsFillHover}"/></Trigger>
        <Trigger Property="Tag" Value="Selected"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsNavSelected}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsNavSelected}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsChoice" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsCardFocus}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <StackPanel Background="Transparent">
        <Border x:Name="Chrome" CornerRadius="12" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1.5" Padding="3">
          <ContentPresenter x:Name="Preview" HorizontalAlignment="Stretch"/>
        </Border>
        <Grid Height="30" Margin="8,4,8,0">
          <TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="Selection" Width="14" Height="14" CornerRadius="7" Background="{DynamicResource SettingsAccent}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden">
            <Path Data="M 3.5,7 L 6,9.5 L 10.5,4.5" Stroke="White" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Border>
        </Grid>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#74747C"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#529DFF"/><Setter TargetName="Selection" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Preview" Property="Opacity" Value="0.85"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A card that adds something, in a theme card's frame (SettingsChoice): a plus in place of the preview, 84 high as a theme
       preview is (CompactStylePreview.ThemeHeight), and the action as its name. -->
  <Style x:Key="SettingsAddCard" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsCardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <StackPanel Background="Transparent">
        <Border x:Name="Chrome" CornerRadius="12" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1.5" Padding="3">
          <Border Height="84" CornerRadius="9" Background="Transparent">
            <Path x:Name="Plus" Data="M 12,0 V 24 M 0,12 H 24" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Border>
        <Grid Height="30" Margin="8,4,8,0">
          <TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#74747C"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Plus" Property="Opacity" Value="0.7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A card that saves unsaved theme changes, in the same frame: a save glyph in place of the plus, and the action as its name,
       both in the card's Foreground (blue to save as a new theme, amber to overwrite the current one). -->
  <Style x:Key="SettingsSaveCard" TargetType="Button">
    <Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsCardFocus}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
      <StackPanel Background="Transparent">
        <Border x:Name="Chrome" CornerRadius="12" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" Padding="3">
          <Border Height="84" CornerRadius="9" Background="Transparent">
            <Path x:Name="Glyph" Data="M 3,1 H 16 L 21,6 V 19 A 2,2 0 0 1 19,21 H 3 A 2,2 0 0 1 1,19 V 3 A 2,2 0 0 1 3,1 Z M 6,1 V 7 H 15 V 1 M 5,21 V 13 H 17 V 21"
                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </Border>
        <Grid Height="30" Margin="8,4,8,0">
          <TextBlock Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
      </StackPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.7"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsTileFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
    <Border BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1.5" CornerRadius="13" Margin="-3"/>
  </ControlTemplate></Setter.Value></Setter></Style>
  <!-- A clock style: the face on the panel theme's surface, with a check at the top right once chosen. -->
  <Style x:Key="SettingsClockTile" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsTileFocus}"/>
    <Setter Property="Height" Value="72"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Chrome" CornerRadius="10" Background="{DynamicResource PanelSurface}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="2">
        <Grid>
          <ContentPresenter x:Name="Preview" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="Selection" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource SettingsAccent}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" Visibility="Hidden">
            <Path Data="M 4,8.2 L 6.9,11 L 12,5.4" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Border>
        </Grid>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#74747C"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/><Setter TargetName="Selection" Property="Visibility" Value="Visible"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Preview" Property="Opacity" Value="0.85"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A clock color: the color as a disc, ringed in the accent once chosen. -->
  <Style x:Key="SettingsClockSwatch" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsRoundFocus}"/>
    <Setter Property="Width" Value="32"/><Setter Property="Height" Value="32"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Grid Width="32" Height="32" Background="Transparent" UseLayoutRounding="False" SnapsToDevicePixels="False">
        <Ellipse x:Name="Ring" Width="32" Height="32" Stroke="Transparent" StrokeThickness="2"/>
        <Ellipse Width="24" Height="24" Fill="{TemplateBinding Background}" Stroke="{DynamicResource SettingsSwatchBorder}" StrokeThickness="0.75"/>
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SettingsSwatchBorder}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SettingsAccent}"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsNumber" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="SelectionBrush" Value="#0A84FF"/><Setter Property="FontSize" Value="12"/>
    <Setter Property="TextAlignment" Value="Right"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Padding" Value="0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Focusable="False"/>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsTrack" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border Background="Transparent"><Border x:Name="Rail" Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers><Trigger Property="Tag" Value="Filled"><Setter TargetName="Rail" Property="Margin" Value="8,0,-8,0"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
    <Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SettingsTrackBrush}" Margin="8,0" VerticalAlignment="Center"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SettingsTrack}" Tag="Filled" Background="{DynamicResource SettingsSliderAccent}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="16" Height="24" Cursor="Hand">
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" Stroke="#B6BCC6" StrokeThickness="0.6" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="KnobScale"/></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.45"/></Ellipse.Effect>
                </Ellipse>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#ECECF0"/></Trigger>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></EventTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SettingsTrack}" Background="Transparent" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
        </Track>
        <Border x:Name="Focus" BorderThickness="1" BorderBrush="#800A84FF" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A slider whose zero sits in the middle: the fill runs from the center tick to the thumb. Code places CenterFill. -->
  <Style x:Key="SettingsCenteredSlider" TargetType="Slider">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
    <Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="True"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
      <Grid Background="Transparent">
        <Border Height="3" CornerRadius="1.5" Background="{DynamicResource SettingsTrackBrush}" Margin="8,0" VerticalAlignment="Center"/>
        <Border x:Name="CenterFill" Height="3" Width="0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource SettingsSliderAccent}" IsHitTestVisible="False"/>
        <Border Width="1" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource SettingsScrollThumb}" IsHitTestVisible="False"/>
        <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SettingsTrack}" Background="Transparent" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Width="16" Height="24" Cursor="Hand">
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" Stroke="#B6BCC6" StrokeThickness="0.6" RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><ScaleTransform x:Name="KnobScale"/></Ellipse.RenderTransform>
                  <Ellipse.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.45"/></Ellipse.Effect>
                </Ellipse>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="#ECECF0"/></Trigger>
                <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.12" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.12" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></EventTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SettingsTrack}" Background="Transparent" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
        </Track>
        <Border x:Name="Focus" BorderThickness="1" BorderBrush="#800A84FF" CornerRadius="8" IsHitTestVisible="False" Visibility="Collapsed"/>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsToggle" TargetType="CheckBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsSwitchFocus}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="16,0,0,0"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
      <!-- Only the switch takes clicks; the label beside it and the empty row are not a click target. -->
      <DockPanel>
        <!-- Initial template state is immediate; only later checked-state changes transition. -->
        <VisualStateManager.VisualStateGroups>
          <VisualStateGroup x:Name="CheckStates">
            <VisualStateGroup.Transitions><VisualTransition GeneratedDuration="0:0:0.15"/></VisualStateGroup.Transitions>
            <!-- The states animate the knob through the ellipse's property path. Named as the target itself, the transform was
                 not moved by the generated transition, so the knob stood still for its duration and then jumped. -->
            <VisualState x:Name="Unchecked"><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Checked"><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0"/></Storyboard></VisualState>
            <VisualState x:Name="Indeterminate"><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0"/></Storyboard></VisualState>
          </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid DockPanel.Dock="Right" Width="38" Height="22" Margin="{TemplateBinding Padding}" Background="Transparent">
          <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource SettingsSwitchOff}" BorderBrush="Transparent" BorderThickness="0"/>
          <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            <Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.3"/></Ellipse.Effect>
          </Ellipse>
        </Grid>
        <ContentPresenter VerticalAlignment="Center" IsHitTestVisible="False"/>
      </DockPanel>
      <ControlTemplate.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccent}"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.88"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsSegment" TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
      <Border x:Name="Selection" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/></Trigger>
        <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsStepper" TargetType="RepeatButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsStepperFocus}"/>
    <Setter Property="Width" Value="21"/><Setter Property="Height" Value="26"/><Setter Property="Focusable" Value="True"/><Setter Property="Delay" Value="400"/><Setter Property="Interval" Value="80"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
      <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" BorderBrush="Transparent" BorderThickness="1"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.RenderTransform><TranslateTransform Y="-1"/></ContentPresenter.RenderTransform></ContentPresenter></Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SettingsFillHover}"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- A slim bar beside a combo box's list: a 4 DIP handle, no track. -->
  <Style x:Key="SettingsThinScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
        <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
        <Track.Thumb><Thumb>
          <Thumb.Template><ControlTemplate TargetType="Thumb">
            <Border Background="Transparent"><Border x:Name="Handle" Background="{DynamicResource SettingsScrollThumb}" CornerRadius="2" Margin="1,2"/></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource SettingsScrollThumbHover}"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource SettingsScrollThumbPressed}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Thumb.Template>
        </Thumb></Track.Thumb>
        <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      </Track>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsCombo" TargetType="ComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="31"/>
    <!-- About eight rows; a longer list scrolls (with the wheel too) instead of running down the screen. -->
    <Setter Property="MaxDropDownHeight" Value="242"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
      <Grid>
        <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <!-- The arrow is drawn, not a glyph: an icon font's glyph sits where that font puts it (and Windows 10 has another icon
               font), so it would not share the text's centre. -->
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Chrome" Background="{DynamicResource SettingsInput}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="6"><Path Data="M0.5,0.5 L4.5,4.5 L8.5,0.5" Width="9" Height="5" Stroke="{DynamicResource SettingsTextSecondary}" StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"><Path.RenderTransform><TranslateTransform Y="0.5"/></Path.RenderTransform></Path></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <ContentPresenter x:Name="Selection" Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,28,0" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
          <!-- Keep the scrollbar in its own column so it never covers a highlighted item. The column stays reserved while
               the pointer leaves the list, preventing the items from shifting when the scrollbar is hidden. -->
          <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Background="{DynamicResource SettingsInput}" BorderBrush="{DynamicResource SettingsBorder}" BorderThickness="1" CornerRadius="6" Padding="4">
            <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly">
              <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/>
                  <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{DynamicResource SettingsThinScrollBar}" Margin="2,0,0,0" Opacity="0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
                </Grid>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PART_VerticalScrollBar" Property="Opacity" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></ScrollViewer.Template>
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </Popup>
        <Border x:Name="Focus" IsHitTestVisible="False" Visibility="Collapsed" BorderBrush="{DynamicResource SettingsAccent}" BorderThickness="1" CornerRadius="6"/>
      </Grid>
      <ControlTemplate.Triggers>
        <!-- Keep the time horizontally centred; offset its natural line box to centre the visible digits vertically. -->
        <Trigger Property="HorizontalContentAlignment" Value="Center">
          <Setter TargetName="Selection" Property="Margin" Value="22,0,22,0"/>
          <Setter TargetName="Selection" Property="RenderTransform"><Setter.Value><TranslateTransform Y="-1.25"/></Setter.Value></Setter>
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="Padding" Value="9,6"/>
      <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsFillHover}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsField" TargetType="TextBox">
    <Setter Property="Height" Value="35"/>
    <Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsInput}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="FontSize" Value="13"/><Setter Property="Padding" Value="10,7"/><Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
      <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
      <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsAccent}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
    <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/>
    <Setter Property="Orientation" Value="Vertical"/><Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
          <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SettingsScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb>
            <Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border Background="Transparent"><Border x:Name="Handle" Background="{DynamicResource SettingsScrollThumb}" CornerRadius="2" Margin="4,2"/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource SettingsScrollThumbHover}"/></Trigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource SettingsScrollThumbPressed}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template>
          </Thumb></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SettingsScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsScrollBar}"/>
  <Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
    <Setter Property="PanningMode" Value="VerticalOnly"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SettingsScrollBar}" Margin="4,0,0,0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- The page area: the scroll bar's column is always reserved, so a page that starts or stops scrolling keeps its width.
       The settings window gives this column back from its right margin, so the bar sits in that margin. -->
  <Style x:Key="SettingsPageScrollViewer" TargetType="ScrollViewer" BasedOn="{StaticResource SettingsScrollViewer}">
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Style="{StaticResource SettingsScrollBar}" Margin="4,0,0,0" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
      </Grid>
    </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsPriceTable" TargetType="DataGrid">
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="Transparent"/><Setter Property="AlternatingRowBackground" Value="Transparent"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SettingsInset}"/>
    <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="50"/><Setter Property="ColumnHeaderHeight" Value="42"/>
    <Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="CanUserReorderColumns" Value="False"/><Setter Property="CanUserResizeRows" Value="False"/><Setter Property="CanUserResizeColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader">
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource SettingsSurface}"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextSecondary}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorder}"/><Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridColumnHeader"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
    <Setter Property="CellStyle"><Setter.Value><Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SettingsTextPrimary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style></Setter.Value></Setter>
    <Setter Property="RowStyle"><Setter.Value><Style TargetType="DataGridRow">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsFillHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsInset}"/></Trigger></Style.Triggers>
    </Style></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsUpdateProgress" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource SettingsAccent}"/>
    <Setter Property="Background" Value="{DynamicResource SettingsTrackBrush}"/>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="ProgressBar">
        <Grid x:Name="PART_Track" ClipToBounds="True">
          <Border Background="{TemplateBinding Background}" CornerRadius="2.5"/>
          <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2.5"/>
        </Grid>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
