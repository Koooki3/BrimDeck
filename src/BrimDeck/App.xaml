<Application x:Class="BrimDeck.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BrimDeck" xmlns:sys="clr-namespace:System;assembly=System.Runtime" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <!-- The panel theme's colors, the dark theme's until PanelTheme publishes the theme in use: it replaces this whole dictionary,
           and panel styles refer to these brushes with DynamicResource. Panel brushes defined directly below would never change. -->
      <ResourceDictionary>
        <SolidColorBrush x:Key="PanelSurface" Color="#000000"/>
        <SolidColorBrush x:Key="PanelPrimary" Color="#F5F5F7"/>
        <SolidColorBrush x:Key="PanelSecondary" Color="#9EEBEBF5"/>
        <SolidColorBrush x:Key="PanelTertiary" Color="#8CEBEBF5"/>
        <SolidColorBrush x:Key="PanelAccent" Color="#0A84FF"/>
        <SolidColorBrush x:Key="PanelTrack" Color="#1FFFFFFF"/>
        <SolidColorBrush x:Key="PanelRingTrack" Color="#29FFFFFF"/>
        <SolidColorBrush x:Key="PanelFill" Color="#12FFFFFF"/>
        <SolidColorBrush x:Key="PanelFillSelected" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="PanelHover" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="PanelPressed" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="PanelPopup" Color="#1A1A1D"/>
        <SolidColorBrush x:Key="PanelPopupBorder" Color="#24FFFFFF"/>
        <SolidColorBrush x:Key="PanelScrollThumb" Color="#515665"/>
        <!-- The handle's opacity at rest (PanelPalette.ThumbRestOpacity). -->
        <sys:Double x:Key="PanelScrollThumbRest">0.55</sys:Double>
        <SolidColorBrush x:Key="PanelSwitchFill" Color="#0FFFFFFF"/>
        <SolidColorBrush x:Key="PanelSeekRail" Color="#2EFFFFFF"/>
        <SolidColorBrush x:Key="PanelToolTip" Color="#1F1F23"/>
        <SolidColorBrush x:Key="PanelToolTipBorder" Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="PanelBubble" Color="#2A2A2E"/>
        <SolidColorBrush x:Key="PanelBubbleBorder" Color="#1AFFFFFF"/>
        <!-- Corners: PanelR1 to PanelR16 are that many DIP, and 0 in a pixel theme (PanelTheme.Corner). -->
        <CornerRadius x:Key="SegmentCorner">5</CornerRadius>
        <CornerRadius x:Key="PanelR1">1</CornerRadius><CornerRadius x:Key="PanelR2">2</CornerRadius><CornerRadius x:Key="PanelR3">3</CornerRadius>
        <CornerRadius x:Key="PanelR4">4</CornerRadius><CornerRadius x:Key="PanelR5">5</CornerRadius><CornerRadius x:Key="PanelR6">6</CornerRadius>
        <CornerRadius x:Key="PanelR7">7</CornerRadius><CornerRadius x:Key="PanelR8">8</CornerRadius><CornerRadius x:Key="PanelR9">9</CornerRadius>
        <CornerRadius x:Key="PanelR10">10</CornerRadius><CornerRadius x:Key="PanelR11">11</CornerRadius><CornerRadius x:Key="PanelR12">12</CornerRadius>
        <CornerRadius x:Key="PanelR13">13</CornerRadius><CornerRadius x:Key="PanelR14">14</CornerRadius><CornerRadius x:Key="PanelR15">15</CornerRadius>
        <CornerRadius x:Key="PanelR16">16</CornerRadius>
      </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="AppTextFont">Microsoft YaHei</FontFamily>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#141416"/>
    <Style TargetType="Window">
      <Setter Property="FontFamily" Value="{StaticResource AppTextFont}"/>
      <Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="#EFF0F5"/>
      <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
      <Setter Property="UseLayoutRounding" Value="True"/>
    </Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <!-- Keyboard focus on the panel and its pop-ups: the music controls' blue, drawn on the control's own edge
         so the island's rounded clip never cuts it. WPF shows it only while moving focus with the keyboard. -->
    <Style x:Key="PanelKeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border BorderBrush="{DynamicResource PanelAccent}" BorderThickness="1" CornerRadius="{DynamicResource PanelR5}"/>
    </ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="PanelWideKeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border BorderBrush="{DynamicResource PanelAccent}" BorderThickness="1" CornerRadius="{DynamicResource PanelR8}"/>
    </ControlTemplate></Setter.Value></Setter></Style>
    <!-- For a control whose own border already turns blue when selected: the outline stands 2 DIP outside it. -->
    <Style x:Key="PanelOutsetKeyboardFocus"><Setter Property="Control.Template"><Setter.Value><ControlTemplate>
      <Border BorderBrush="{DynamicResource PanelAccent}" BorderThickness="1" CornerRadius="{DynamicResource PanelR10}" Margin="-2"/>
    </ControlTemplate></Setter.Value></Setter></Style>
    <!-- One segment of a joined switch on the panel: the selected segment carries Tag="Selected". -->
    <Style x:Key="SegmentButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PanelSecondary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{StaticResource AppTextFont}"/>
      <Setter Property="Padding" Value="10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource PanelKeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <!-- Lit by Feedback where a style turns it on (ToolbarActionButton). -->
            <Border x:Name="HoverLayer" Background="{DynamicResource PanelHover}" CornerRadius="{DynamicResource SegmentCorner}" Opacity="0"/>
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource SegmentCorner}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/></Trigger>
            <Trigger Property="Tag" Value="Selected"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelFillSelected}"/><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <!-- Chosen in a strip whose fill glides between its segments (MainWindow.Segmented): the text only. -->
            <Trigger Property="Tag" Value="Chosen"><Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <!-- A standalone toolbar action in the segment look: 6 DIP corner and a gray hover, like the other toolbar buttons. -->
    <Style x:Key="ToolbarActionButton" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
      <Style.Resources><CornerRadius x:Key="SegmentCorner">6</CornerRadius></Style.Resources>
      <Setter Property="local:Feedback.Fade" Value="True"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#DCDEE7"/><Setter Property="Background" Value="#252730"/>
      <Setter Property="BorderBrush" Value="#343640"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,7"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource PanelWideKeyboardFocus}"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.78"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.55"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F2F3F7"/><Setter Property="CaretBrush" Value="#3478F6"/>
      <Setter Property="Background" Value="#18181A"/><Setter Property="BorderBrush" Value="#3A3C47"/>
      <Setter Property="Padding" Value="9,7"/><Setter Property="SelectionBrush" Value="#29559A"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EFF0F5"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <DockPanel LastChildFill="True">
            <Border x:Name="Track" DockPanel.Dock="Right" Width="38" Height="22" CornerRadius="11" Background="#444650" Margin="16,0,0,0">
              <Ellipse x:Name="Thumb" Width="16" Height="16" Fill="#EBECF2" HorizontalAlignment="Left" Margin="3"/>
            </Border>
            <ContentPresenter VerticalAlignment="Center"/>
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#3478F6"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="PanningMode" Value="VerticalOnly"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollViewer">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"/>
            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="6" Margin="3,0,0,0" Orientation="Vertical" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="7"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <!-- At rest a thin, faint handle that keeps out of the text's way; under the pointer, or while dragged, it widens and
                 strengthens. The bar keeps its width, so nothing moves when the handle changes. -->
            <Track.Thumb><Thumb MinHeight="22"><Thumb.Template><ControlTemplate TargetType="Thumb">
              <Border Background="Transparent">
                <Border x:Name="Handle" Width="3" HorizontalAlignment="Right" Background="{DynamicResource PanelScrollThumb}" CornerRadius="{DynamicResource PanelR3}" Margin="0,2,1,2" Opacity="{DynamicResource PanelScrollThumbRest}"/>
              </Border>
              <ControlTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="True">
                  <Setter TargetName="Handle" Property="Width" Value="6"/><Setter TargetName="Handle" Property="Opacity" Value="1"/>
                </DataTrigger>
                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Width" Value="6"/><Setter TargetName="Handle" Property="Opacity" Value="1"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{TemplateBinding Background}" CornerRadius="2"/></ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Height" Value="24"/><Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid>
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}">
              <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="#3478F6" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb Width="17" Height="17"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#F3F3F5" Stroke="#F3F3F5" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="#36363A" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="BrimDeckToolTip" TargetType="ToolTip">
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource PanelPrimary}"/>
      <Setter Property="Background" Value="{DynamicResource PanelToolTip}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelToolTipBorder}"/>
      <Setter Property="Padding" Value="9,5"/>
      <Setter Property="MaxWidth" Value="380"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <!-- No bitmap effect: a blurred shadow on a layered popup is rendered in software and delays the first paint. -->
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource PanelR6}"
                  Padding="{TemplateBinding Padding}" Margin="2" SnapsToDevicePixels="True">
            <ContentPresenter TextBlock.LineHeight="16" TextBlock.LineStackingStrategy="BlockLineHeight"/>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource BrimDeckToolTip}"/>
    <!-- Tray menu: compact, no icon column, follows the system's app theme like the shell's own tray menus.
         The dark palette is the default here; TrayIcon.CreateMenu swaps in the light palette when apps use the light theme. -->
    <SolidColorBrush x:Key="MenuSurface" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="MenuInk" Color="#F0F0F0"/>
    <!-- The text of the highlighted item: the same ink, except in high contrast, where it stands on the highlight color. -->
    <SolidColorBrush x:Key="MenuInkHover" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuEdge" Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="MenuHover" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="MenuRule" Color="#3F3F3F"/>
    <Style TargetType="ContextMenu">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource MenuInk}"/>
      <Setter Property="HasDropShadow" Value="False"/><Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource MenuEdge}" BorderThickness="1" CornerRadius="7"
                  Padding="3" Margin="2" MinWidth="104" SnapsToDevicePixels="True">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Foreground" Value="{DynamicResource MenuInk}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Height="26" Padding="12,0" SnapsToDevicePixels="True">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource MenuHover}"/><Setter Property="Foreground" Value="{DynamicResource MenuInkHover}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="{DynamicResource MenuRule}" Margin="4,3"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
