<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the pointer answers on real WPF controls and renders frame strips of them; not part of BrimDeck.sln (see Program.cs). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BrimDeck\BrimDeck.csproj" />
    <ProjectReference Include="..\..\src\BrimDeck.Core\BrimDeck.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
