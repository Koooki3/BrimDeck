<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the notice window's warm-up (IslandNotice.Prepare) on the real IslandNotice, far off screen; nothing is shown on a screen.
       Run: dotnet run, with the project as the argument (tests/BrimDeck.IslandChecks), in Release -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\BrimDeck\BrimDeck.csproj" />
    <ProjectReference Include="..\..\src\BrimDeck.Core\BrimDeck.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
